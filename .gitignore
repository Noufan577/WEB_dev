# ==============================================================================
# 📦 DEPENDENCIES & PACKAGE MANAGERS
# ==============================================================================
# Ignore node_modules in any nested project folder
**/node_modules/
**/node_modules/**

# Common package manager metadata
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Optional: ignore lock files in this multi-project workspace if you do not want them tracked
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml

# ============================================================================== 
# 🔐 ENV & SECRETS
# ============================================================================== 
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key

# ============================================================================== 
# 🏗️ BUILD OUTPUTS & COMPILED ARTIFACTS
# ============================================================================== 
**/dist/
**/build/
**/out/
**/coverage/
**/.next/
**/.nuxt/
**/.svelte-kit/
**/.docusaurus/
**/.cache/
**/.parcel-cache/
**/.vite/
**/.turbo/
**/lib-cov/
**/build/Release/

# TypeScript incremental compilation cache
**/*.tsbuildinfo

# ============================================================================== 
# 🧪 LOGS, DIAGNOSTICS & CACHES
# ============================================================================== 
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/lerna-debug.log*
**/report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
**/pids/
**/*.pid
**/*.seed
**/*.pid.lock
**/.nyc_output/
**/.eslintcache
**/.prettiercache
**/.stylelintcache

# ============================================================================== 
# 💻 IDE, EDITORS & SYSTEM FILES
# ============================================================================== 
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
.DS_Store
Thumbs.db

# Optional: if you want to keep the root repo cleaner, ignore the root-level lockfile too
/package-lock.json
